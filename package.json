{
  "name": "liftly",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm -r typecheck && pnpm -r test",
    "e2e": "pnpm --filter @liftly/web e2e",
    "build": "pnpm --filter @liftly/web build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
