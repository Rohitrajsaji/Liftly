{
  "name": "@liftly/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "vite build --mode e2e && playwright test",
    "build:e2e": "vite build --mode e2e",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@liftly/catalog": "workspace:*",
    "@liftly/engine": "workspace:*",
    "@liftly/workout": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "dexie": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^2.1.0"
  }
}
